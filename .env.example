# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=food_ordering
DB_USER=root
DB_PASS=

# Application
APP_NAME=Cafe
APP_ENV=development
APP_DEBUG=true
# Address used in table QR codes and emails. Use your computer's Wi-Fi IP so phones can open it,
# e.g. http://192.168.1.20/food-ordering. Leave empty to use the address you opened the dashboard with.
APP_URL=

# Session
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=lax

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@cafe.test
MAIL_FROM_NAME=Cafe

# Payment (Demo - replace with real credentials for production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Security
CSRF_SECRET=change_this_to_random_32_char_string
ENCRYPTION_KEY=change_this_to_random_32_char_string